<?xml version="1.0" encoding="UTF-8"?>
<xml>
	<pragma once="true" />

	<set name="PROJECT_DIR" value="${haxelib:hxlua_lib}/project" />

	<files id="haxe">
		<section unless="linux">
			<compilerflag value="-I${PROJECT_DIR}/include" />
		</section>
	</files>

	<files id="__main__">
		<section unless="linux">
			<compilerflag value="-I${PROJECT_DIR}/include" />
		</section>
	</files>

	<target id="haxe">
		<section if="windows">
			<section if="HXCPP_M64">
				<lib name="${PROJECT_DIR}/lib/Windows64/lua51.lib" />
			</section>

			<section if="HXCPP_M32">
				<lib name="${PROJECT_DIR}/lib/Windows/lua51.lib" />
			</section>
		</section>

		<section if="macos">
			<vflag name="-rpath" value="@executable_path/lib/" />

			<section if="HXCPP_M64 || HXCPP_ARM64">
			</section>
		</section>

		<section if="linux">
		</section>

		<section if="android">
		</section>

		<section if="iphoneos || iphonesim">
			<section if="HXCPP_ARM64">
				<section if="iphoneos">
					<section unless="HXVLC_CUSTOM_IOS_DEVICE_LIB">
					</section>

					<section if="HXVLC_CUSTOM_IOS_DEVICE_LIB">
					</section>
				</section>

				<section if="iphonesim || simulator">
					<section unless="HXVLC_CUSTOM_IOS_SIMULATOR_LIB">
					</section>

					<section if="HXVLC_CUSTOM_IOS_SIMULATOR_LIB">
					</section>
				</section>
			</section>
		</section>
	</target>
</xml>