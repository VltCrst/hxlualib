<?xml version="1.0" encoding="UTF-8"?>
<extension
	xmlns="http://lime.openfl.org/project/1.0.4"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

	<section if="windows || mac">
		<library name="luajit" preload="false" />
	</section>

	<section if="windows">
		<section if="32bits">
			<assets path="project/lib/Windows" rename="" include="*.dll" library="luajit" />
		</section>

		<section unless="32bits">
			<assets path="project/lib/Windows64" rename="" include="*.dll" library="luajit" />
		</section>
	</section>

	<section if="mac">
		<assets path="project/lib/MacOS" rename="../MacOS/lib" include="*.dylib" library="luajit" />
	</section>

	<section if="android">
		<ndll name="c++_shared" dir="project/lib" />
		<ndll name="lua" dir="project/lib" />
	</section>

	<section if="ios">
		<dependency name="libiconv.tbd" />
	</section>

	<sample path="samples" />

	<source path="src" />
</extension>